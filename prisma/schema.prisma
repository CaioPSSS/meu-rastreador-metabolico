datasource db {
      provider  = "postgresql"
        url       = env("POSTGRES_PRISMA_URL") // URL padrão fornecida pelo Vercel Postgres
          directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
      provider = "prisma-client-js"
}

model UserSettings {
      id                   String   @id @default("singleton")
        age                  Int
          height               Float    // em cm
            gender               String   // "M" ou "F"
              activityLevel        Float    // Fator multiplicador (ex: 1.375)
                goal                 String   // "loss" (perder), "maintenance" (manter), "gain" (ganhar)
                  weeklyRate           Float    // Kg por semana (ex: -0.5 para perder 500g)
                    currentCalorieTarget Int
                    previousCalorieTarget Int?     // Meta anterior (para auditoria de mudanças)
      lastRecalcAt         DateTime? // Quando a meta calórica foi ajustada pela última vez
        recalcReason         String?   // Motivo do ajuste (ex: "weekly_cycle", "ai_decision", "initial")
          createdAt            DateTime @default(now())
            updatedAt            DateTime @updatedAt
}

model DailyLog {
      date             String   @id // Formato ISO "YYYY-MM-DD" (evita problemas de timezone)
        weight           Float?   // Peso em kg (opcional)
          caloriesConsumed Int?     // Calorias ingeridas (opcional)
            caloriesBurned   Int?     // Calorias gastas com exercícios (opcional)
              trainingType     String   // "Descanso", "Musculação", "Corrida", "Híbrido", "Livre"
                sleepHours       Float?   // Horas de sono reportadas
                  waterIntake      Int?     // Água ingerida em ml
                    stressLevel      Int?     // Nível subjetivo de estresse 1-5
                      mood             String?  // Humor diário
                      proteinConsumed Int?     // Proteína consumida em gramas
                      waistCircumference Float? // Circunferência da cintura em cm
                        createdAt        DateTime @default(now())

  @@index([date(sort: Desc)])
}

model AiReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String   @db.Text
  isRead    Boolean  @default(false)

  // Memória acumulativa — alimenta o contexto de prompts futuros
  weekSummary     Json?  // WeekSummary: snapshot das métricas da semana
  recommendations Json?  // String[]: diretrizes táticas extraídas do relatório

  // Decisão de recalibração — rastreabilidade e exibição no dashboard
  recalibration   Json?  // RecalibrationResult: decisão da IA árbitro + reasoning

  @@index([createdAt(sort: Desc)])
}

model FoodItem {
  id          String     @id @default(cuid())
  name        String     // Ex: "Peito de frango grelhado"
  brand       String?    // Ex: "TACO", "Sadia", "Nestlé", "Caseiro"
  barcode     String?    @unique // Código de barras EAN-13 / UPC
  servingSize Float      @default(100) // Tamanho da porção de referência (ex: 100)
  servingUnit String     @default("g") // "g", "ml", "un", "fatia", "colher"
  calories    Float      // Calorias na porção de referência (kcal)
  protein     Float      // Proteínas (g)
  carbs       Float      // Carboidratos (g)
  fat         Float      // Gorduras totais (g)
  fiber       Float?     // Fibras (g, opcional)
  sodium      Float?     // Sódio (mg, opcional)
  isCustom    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  mealItems   MealItem[]

  @@index([name])
  @@index([barcode])
}

model Meal {
  id        String     @id @default(cuid())
  date      String     // "YYYY-MM-DD" compatível com DailyLog
  name      String     // "Café da Manhã", "Almoço", "Lanche da Tarde", "Jantar", etc.
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     MealItem[]

  @@index([date])
}

model MealItem {
  id         String    @id @default(cuid())
  mealId     String
  meal       Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)

  foodItemId String?
  foodItem   FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  name       String    // Nome do item no momento do consumo
  amount     Float     // Quantidade consumida (ex: 150)
  unit       String    // "g", "ml", "un", "porção"

  calories   Float     // kcal
  protein    Float     // g
  carbs      Float     // g
  fat        Float     // g
  fiber      Float?    // g

  isQuickAdd Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([mealId])
}